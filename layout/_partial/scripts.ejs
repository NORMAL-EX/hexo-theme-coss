<%# Heading Anchor Links + TOC scrollspy %>
<script>
(function() {
  var prose = document.querySelector('.prose');
  if (!prose) return;

  var headings = prose.querySelectorAll('h1, h2, h3, h4, h5, h6');
  headings.forEach(function(heading) {
    if (!heading.id) {
      var text = heading.textContent || '';
      var id = text.trim().toLowerCase().replace(/[\s]+/g, '-').replace(/[^一-龥\w\-]/g, '');
      if (id) heading.id = id;
    }
    if (!heading.id || heading.querySelector('.heading-anchor')) return;
    var anchor = document.createElement('a');
    anchor.className = 'heading-anchor';
    anchor.href = '#' + heading.id;
    anchor.textContent = '#';
    anchor.setAttribute('aria-hidden', 'true');
    anchor.title = '复制链接';
    anchor.addEventListener('click', function(e) {
      e.preventDefault();
      var top = heading.getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top: top, behavior: 'smooth' });
      history.pushState(null, null, '#' + encodeURIComponent(heading.id));
      var url = window.location.href.split('#')[0] + '#' + encodeURIComponent(heading.id);
      if (navigator.clipboard) navigator.clipboard.writeText(url).then(function() {
        if (window.cossToast) window.cossToast('链接已复制', 'success');
      }).catch(function() {});
    });
    heading.classList.add('heading-with-anchor');
    heading.appendChild(anchor);
  });

  // TOC smooth scroll
  var tocLinks = document.querySelectorAll('.toc-link');
  tocLinks.forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      var href = this.getAttribute('href') || '';
      var targetId = href.startsWith('#') ? href.slice(1) : href;
      try { targetId = decodeURIComponent(targetId); } catch (err) {}
      var target = document.getElementById(targetId);
      if (!target) {
        var linkText = this.textContent.trim();
        headings.forEach(function(h) { if (h.textContent.replace('#', '').trim() === linkText) target = h; });
      }
      if (target) {
        var top = target.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: top, behavior: 'smooth' });
        history.pushState(null, null, '#' + encodeURIComponent(target.id));
      }
    });
  });

  // TOC scrollspy（基于滚动位置实时计算，跟手无延迟）
  if (tocLinks.length && headings.length) {
    var headingArr = Array.prototype.slice.call(headings);
    function setActiveToc() {
      var current = headingArr[0];
      for (var i = 0; i < headingArr.length; i++) {
        if (headingArr[i].getBoundingClientRect().top <= 100) current = headingArr[i];
        else break;
      }
      var curId = current ? current.id : '';
      tocLinks.forEach(function(link) {
        var href = link.getAttribute('href') || '';
        var linkId = href.startsWith('#') ? href.slice(1) : href;
        try { linkId = decodeURIComponent(linkId); } catch (err) {}
        link.classList.toggle('active', linkId === curId);
      });
    }
    var tocTicking = false;
    window.addEventListener('scroll', function() {
      if (!tocTicking) { window.requestAnimationFrame(function() { setActiveToc(); tocTicking = false; }); tocTicking = true; }
    }, { passive: true });
    setActiveToc();
  }

  // 进入时根据 hash 定位
  if (window.location.hash) {
    setTimeout(function() {
      var hash = window.location.hash.slice(1);
      try { hash = decodeURIComponent(hash); } catch (err) {}
      var target = document.getElementById(hash);
      if (target) {
        var top = target.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
    }, 120);
  }
})();
</script>

<%# Code Blocks Enhancement - 语言标签 + 复制按钮（兼容 Hexo highlight 与普通代码块） %>
<script>
(function() {
  var copyIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>';
  var checkIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>';

  // Coss UI outline button（small），完整 class
  var copyBtnCls = "code-copy-btn not-prose [&_svg]:-mx-0.5 relative inline-flex shrink-0 cursor-pointer items-center justify-center gap-1 whitespace-nowrap rounded-md border font-medium text-xs outline-none transition-shadow before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-md)-1px)] focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 focus-visible:ring-offset-background h-7 px-2 [&_svg:not([class*='size-'])]:size-3.5 [&_svg]:pointer-events-none [&_svg]:shrink-0 border-border bg-background bg-clip-padding shadow-xs not-active:not-data-pressed:before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-input/32 dark:bg-clip-border dark:not-active:not-data-pressed:before:shadow-[0_-1px_--theme(--color-white/8%)] [:hover,[data-pressed]]:bg-accent/50 dark:[:hover,[data-pressed]]:bg-input/64";

  function makeCopyBtn() {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = copyBtnCls;
    btn.title = '复制代码';
    btn.setAttribute('aria-label', '复制代码');
    btn.innerHTML = copyIcon;
    return btn;
  }

  function bindCopy(btn, getText) {
    btn.addEventListener('click', function() {
      if (btn.classList.contains('copied')) return;
      var text = getText();
      function done() {
        btn.classList.add('copied');
        btn.innerHTML = '<span>Copied!</span>';
        setTimeout(function() { btn.classList.remove('copied'); btn.innerHTML = copyIcon; }, 2000);
      }
      if (navigator.clipboard) navigator.clipboard.writeText(text).then(done).catch(function() {});
      else {
        var ta = document.createElement('textarea');
        ta.value = text; document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); done(); } catch (e) {}
        ta.remove();
      }
    });
  }

  // Hexo 高亮代码块：顶部工具条放复制按钮
  document.querySelectorAll('figure.highlight').forEach(function(fig) {
    if (fig.dataset.enhanced) return;
    fig.dataset.enhanced = '1';
    fig.classList.add('not-prose');
    var header = document.createElement('div');
    header.className = 'code-header';
    var btn = makeCopyBtn();
    header.appendChild(btn);
    fig.insertBefore(header, fig.firstChild);
    bindCopy(btn, function() {
      var codeCell = fig.querySelector('td.code, .code');
      return (codeCell ? codeCell.innerText : fig.innerText).replace(/\n$/, '');
    });
  });

  // 普通代码块 pre > code：浮动复制按钮
  document.querySelectorAll('.prose pre').forEach(function(pre) {
    if (pre.closest('figure.highlight') || pre.dataset.enhanced) return;
    pre.dataset.enhanced = '1';
    var code = pre.querySelector('code');
    var wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);
    var toolbar = document.createElement('div');
    toolbar.className = 'code-toolbar';
    var btn2 = makeCopyBtn();
    toolbar.appendChild(btn2);
    wrapper.appendChild(toolbar);
    bindCopy(btn2, function() { return (code ? code.innerText : pre.innerText).replace(/\n$/, ''); });
  });
})();
</script>

<%# Image Lightbox %>
<script>
(function() {
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightbox-img');
  var lightboxClose = document.getElementById('lightbox-close');
  if (!lightbox || !lightboxImg) return;

  function open(src, alt) {
    lightboxImg.src = src;
    lightboxImg.alt = alt || '';
    lightbox.classList.add('open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    lightbox.classList.remove('open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    setTimeout(function() { lightboxImg.src = ''; }, 300);
  }

  document.querySelectorAll('.prose img:not(.no-zoom)').forEach(function(img) {
    img.addEventListener('click', function() { open(img.currentSrc || img.src, img.alt); });
  });

  lightbox.addEventListener('click', function(e) { if (e.target === lightbox || e.target === lightboxImg) close(); });
  if (lightboxClose) lightboxClose.addEventListener('click', close);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && lightbox.classList.contains('open')) close(); });
})();
</script>

<%# Image Skeleton Loading %>
<script>
(function() {
  function setup(img) {
    var holder = img.parentElement;
    if (!holder || holder.dataset.skeletonReady) return;
    holder.dataset.skeletonReady = '1';
    holder.classList.add('img-skeleton');
    img.classList.add('img-fade');
    function reveal() {
      img.classList.add('loaded');
      holder.classList.remove('img-skeleton');
    }
    if (img.complete && img.naturalWidth > 0) reveal();
    else { img.addEventListener('load', reveal); img.addEventListener('error', reveal); }
  }
  document.querySelectorAll('.aspect-video img, [data-slot="avatar-image"]').forEach(setup);
})();
</script>

<%# Wrap tables with rounded frame %>
<script>
(function() {
  document.querySelectorAll('.prose table').forEach(function(table) {
    var parent = table.parentNode;
    if (parent && parent.classList && parent.classList.contains('table-wrapper')) return;
    var wrapper = document.createElement('div');
    wrapper.className = 'table-wrapper';
    parent.insertBefore(wrapper, table);
    wrapper.appendChild(table);
  });
})();
</script>

