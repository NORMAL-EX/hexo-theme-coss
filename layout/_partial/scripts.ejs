<%# Toast 通知助手 - 全局 window.cossToast(message, variant) %>
<script>
(function() {
  var icons = {
    success: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>',
    info: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>',
    error: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>'
  };
  window.cossToast = function(message, variant) {
    variant = variant || 'success';
    var container = document.getElementById('toast-container');
    if (!container) return;
    var toast = document.createElement('div');
    toast.className = 'coss-toast';
    toast.setAttribute('data-variant', variant);
    toast.innerHTML = (icons[variant] || icons.info) + '<span>' + message + '</span>';
    container.appendChild(toast);
    requestAnimationFrame(function() {
      requestAnimationFrame(function() { toast.classList.add('show'); });
    });
    setTimeout(function() {
      toast.classList.remove('show');
      setTimeout(function() { toast.remove(); }, 300);
    }, 2200);
  };
})();
</script>

<%# Theme Toggle Menu Script %>
<script>
(function() {
  var html = document.documentElement;
  var STORAGE_KEY = 'hexo-theme-mode';
  var menu = document.getElementById('theme-menu');
  var trigger = document.getElementById('theme-trigger');
  var popup = document.getElementById('theme-popup');
  var options = popup ? popup.querySelectorAll('.theme-option') : [];

  function getTheme() { return localStorage.getItem(STORAGE_KEY) || 'system'; }
  function systemDark() { return window.matchMedia('(prefers-color-scheme: dark)').matches; }

  function applyTheme(theme) {
    if (theme === 'dark' || (theme === 'system' && systemDark())) html.classList.add('dark');
    else html.classList.remove('dark');
  }

  function updateTrigger(theme) {
    if (!trigger) return;
    var l = trigger.querySelector('.theme-icon-light');
    var d = trigger.querySelector('.theme-icon-dark');
    var s = trigger.querySelector('.theme-icon-system');
    [l, d, s].forEach(function(el) { if (el) el.classList.add('hidden'); });
    var active = theme === 'light' ? l : theme === 'dark' ? d : s;
    if (active) active.classList.remove('hidden');
    var labels = { light: '浅色模式', dark: '深色模式', system: '跟随系统' };
    trigger.setAttribute('title', '主题：' + (labels[theme] || '跟随系统'));
  }

  function updateChecks(theme) {
    options.forEach(function(opt) {
      var chk = opt.querySelector('.theme-check');
      var on = opt.getAttribute('data-theme') === theme;
      if (chk) chk.classList.toggle('hidden', !on);
      opt.setAttribute('aria-checked', on ? 'true' : 'false');
    });
  }

  function setTheme(theme) {
    localStorage.setItem(STORAGE_KEY, theme);
    applyTheme(theme);
    updateTrigger(theme);
    updateChecks(theme);
  }

  function openMenu() { if (popup) { popup.classList.remove('closed'); if (trigger) trigger.setAttribute('aria-expanded', 'true'); } }
  function closeMenu() { if (popup) { popup.classList.add('closed'); if (trigger) trigger.setAttribute('aria-expanded', 'false'); } }

  applyTheme(getTheme());
  updateTrigger(getTheme());
  updateChecks(getTheme());

  if (trigger) trigger.addEventListener('click', function(e) {
    e.stopPropagation();
    if (popup && popup.classList.contains('closed')) openMenu(); else closeMenu();
  });
  options.forEach(function(opt) {
    opt.addEventListener('click', function() { setTheme(opt.getAttribute('data-theme')); closeMenu(); });
  });
  document.addEventListener('click', function(e) { if (menu && !menu.contains(e.target)) closeMenu(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMenu(); });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
    if (getTheme() === 'system') applyTheme('system');
  });
})();
</script>

