<%# Toast 通知助手 - 全局 window.cossToast(message, variant) %>
<script>
(function() {
  var icons = {
    success: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>',
    info: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>',
    error: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>'
  };
  window.cossToast = function(message, variant) {
    variant = variant || 'success';
    var container = document.getElementById('toast-container');
    if (!container) return;
    var toast = document.createElement('div');
    toast.className = 'coss-toast';
    toast.setAttribute('data-variant', variant);
    toast.innerHTML = (icons[variant] || icons.info) + '<span>' + message + '</span>';
    container.appendChild(toast);
    requestAnimationFrame(function() {
      requestAnimationFrame(function() { toast.classList.add('show'); });
    });
    setTimeout(function() {
      toast.classList.remove('show');
      setTimeout(function() { toast.remove(); }, 300);
    }, 2200);
  };
})();
</script>

<%# Theme Toggle Script %>
<script>
(function() {
  var themeToggle = document.getElementById('theme-toggle');
  var html = document.documentElement;
  var STORAGE_KEY = 'hexo-theme-mode';

  function getTheme() {
    return localStorage.getItem(STORAGE_KEY) || 'system';
  }

  function setTheme(theme) {
    localStorage.setItem(STORAGE_KEY, theme);
    applyTheme(theme);
    updateIcon(theme);
  }

  function applyTheme(theme) {
    if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      html.classList.add('dark');
    } else {
      html.classList.remove('dark');
    }
  }

  function updateIcon(theme) {
    if (!themeToggle) return;
    var light = themeToggle.querySelector('.theme-icon-light');
    var dark = themeToggle.querySelector('.theme-icon-dark');
    var system = themeToggle.querySelector('.theme-icon-system');
    [light, dark, system].forEach(function(el) { if (el) el.classList.add('hidden'); });
    var active = theme === 'light' ? light : theme === 'dark' ? dark : system;
    if (active) active.classList.remove('hidden');
    var labels = { light: '浅色模式', dark: '深色模式', system: '跟随系统' };
    themeToggle.setAttribute('title', '主题：' + (labels[theme] || '跟随系统'));
  }

  updateIcon(getTheme());

  if (themeToggle) {
    themeToggle.addEventListener('click', function() {
      var current = getTheme();
      var next = current === 'light' ? 'dark' : current === 'dark' ? 'system' : 'light';
      setTheme(next);
    });
  }

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
    if (getTheme() === 'system') applyTheme('system');
  });
})();
</script>

