<%# Search Script %>
<script>
(function() {
  var searchToggles = [document.getElementById('search-toggle'), document.getElementById('search-toggle-mobile')].filter(Boolean);
  var searchModal = document.getElementById('search-modal');
  var searchClose = document.getElementById('search-close');
  var searchInput = document.getElementById('search-input');
  var searchResults = document.getElementById('search-results');
  var searchData = [];

  fetch('<%= url_for("/search.json") %>')
    .then(function(r) { return r.json(); })
    .then(function(data) { searchData = data; })
    .catch(function() {});

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function openSearch() {
    if (!searchModal) return;
    searchModal.classList.remove('hidden');
    searchModal.offsetHeight;
    searchModal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    if (searchInput) setTimeout(function() { searchInput.focus(); }, 100);
  }

  function closeSearch() {
    if (!searchModal) return;
    searchModal.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(function() {
      searchModal.classList.add('hidden');
      if (searchInput) searchInput.value = '';
      if (searchResults) searchResults.innerHTML = '<div class="px-4 py-10 text-center text-sm text-muted-foreground">输入关键词开始搜索</div>';
    }, 300);
  }

  function performSearch(query) {
    if (!searchResults) return;
    if (!query.trim()) {
      searchResults.innerHTML = '<div class="px-4 py-10 text-center text-sm text-muted-foreground">输入关键词开始搜索</div>';
      return;
    }
    var lowerQuery = query.toLowerCase();
    var results = searchData.filter(function(item) {
      return item.title.toLowerCase().includes(lowerQuery) ||
        (item.content && item.content.toLowerCase().includes(lowerQuery));
    }).slice(0, 10);

    if (results.length === 0) {
      searchResults.innerHTML = '<div class="px-4 py-10 text-center text-sm text-muted-foreground">没有找到相关结果</div>';
      return;
    }

    var html = '<ul class="px-2 py-2">';
    results.forEach(function(item) {
      html += '<li class="search-result-item"><a href="' + item.url + '" class="block px-3 py-2.5 rounded-lg hover:bg-accent transition-colors group">';
      html += '<div class="flex items-center justify-between gap-2 mb-0.5">';
      html += '<h4 class="font-medium text-foreground group-hover:text-primary transition-colors line-clamp-1">' + escapeHtml(item.title) + '</h4>';
      if (item.date) html += '<span class="text-xs text-muted-foreground shrink-0 tabular-nums">' + escapeHtml(item.date) + '</span>';
      html += '</div>';
      if (item.excerpt) html += '<p class="text-sm text-muted-foreground line-clamp-2">' + escapeHtml(item.excerpt) + '</p>';
      html += '</a></li>';
    });
    html += '</ul>';
    searchResults.innerHTML = html;
  }

  searchToggles.forEach(function(btn) { btn.addEventListener('click', openSearch); });
  if (searchClose) searchClose.addEventListener('click', closeSearch);
  if (searchModal) searchModal.addEventListener('click', function(e) { if (e.target === searchModal) closeSearch(); });
  if (searchInput) {
    var debounceTimer;
    searchInput.addEventListener('input', function(e) {
      clearTimeout(debounceTimer);
      var val = e.target.value;
      debounceTimer = setTimeout(function() { performSearch(val); }, 250);
    });
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSearch();
    if (e.key === 'k' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); openSearch(); }
  });
})();
</script>

<%# Reading Progress Bar %>
<script>
(function() {
  var bar = document.getElementById('reading-progress');
  if (!bar) return;
  var ticking = false;
  function update() {
    var doc = document.documentElement;
    var max = doc.scrollHeight - doc.clientHeight;
    var pct = max > 0 ? (doc.scrollTop || document.body.scrollTop) / max * 100 : 0;
    bar.style.width = Math.min(100, Math.max(0, pct)) + '%';
    ticking = false;
  }
  function onScroll() {
    if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
})();
</script>

<%# Back to Top visibility（仅在向下箭头滚出视口后才显示，二者不同时出现）%>
<script>
(function() {
  var backToTop = document.getElementById('back-to-top');
  if (!backToTop) return;
  var scrollDown = document.getElementById('scroll-to-posts');

  function show() {
    backToTop.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
    backToTop.classList.add('opacity-100', 'translate-y-0');
  }
  function hide() {
    backToTop.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
    backToTop.classList.remove('opacity-100', 'translate-y-0');
  }

  var ticking = false;
  function update() {
    var downVisible = scrollDown && scrollDown.getBoundingClientRect().bottom > 0;
    if (!downVisible && window.scrollY > 200) show(); else hide();
    ticking = false;
  }
  window.addEventListener('scroll', function() {
    if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();

  backToTop.addEventListener('click', function() { window.scrollTo({ top: 0, behavior: 'smooth' }); });
})();
</script>

