<%
  // 当前路径归一化，用于导航高亮
  var normalizePath = function (p) {
    var s = '/' + String(p == null ? '' : p);
    s = s.replace(/index\.html$/, '').replace(/\/{2,}/g, '/').replace(/\/+$/, '');
    return s || '/';
  };
  var currentPath = normalizePath(page.path);
%>
<header class="sticky top-0 z-50 w-full border-b coss-glass">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between gap-4">
      <%# Logo %>
      <a href="<%= url_for('/') %>" class="flex items-center gap-2.5 shrink-0 group">
        <% if (theme.logo) { %>
        <span class="inline-flex size-8 shrink-0 select-none items-center justify-center overflow-hidden rounded-full bg-background align-middle ring-1 ring-border transition-transform group-hover:scale-105" data-slot="avatar">
          <img src="<%= url_for(theme.logo) %>" alt="<%= config.title %>" class="size-full object-cover" data-slot="avatar-image">
        </span>
        <% } else { %>
        <span class="text-xl font-bold tracking-tight"><%= config.title %></span>
        <% } %>
        <% if (theme.header_title) { %>
        <span class="text-base font-semibold tracking-tight hidden sm:inline"><%= theme.header_title %></span>
        <% } %>
      </a>

      <%# Desktop Navigation %>
      <nav class="hidden md:flex items-center gap-1 flex-1 justify-center">
        <% if (theme.menu) { %>
          <% for (var key in theme.menu) { %>
            <% var menuPath = theme.menu[key]; %>
            <% var isLinksMenu = menuPath === '/links/' || menuPath === '/links'; %>
            <% var linksEnabled = !theme.links || theme.links.enable !== false; %>
            <% if (!isLinksMenu || linksEnabled) { %>
              <%
                var target = normalizePath(menuPath);
                var menuActive = target === '/' ? currentPath === '/' : (currentPath === target || currentPath.indexOf(target + '/') === 0);
              %>
              <a href="<%= url_for(menuPath) %>" class="relative inline-flex items-center h-8 px-3 rounded-md text-sm font-medium transition-colors <%= menuActive ? 'text-foreground bg-accent' : 'text-muted-foreground hover:text-foreground hover:bg-accent/60' %>">
                <%= key %>
              </a>
            <% } %>
          <% } %>
        <% } %>
      </nav>

      <%# Right Actions %>
      <div class="flex items-center gap-2 shrink-0">
        <%# Search - Desktop: 仿输入框样式按钮 %>
        <button type="button" id="search-toggle" class="hidden md:inline-flex items-center gap-2 h-8 pl-2.5 pr-1.5 rounded-md border border-input bg-background bg-clip-padding text-sm text-muted-foreground shadow-xs transition-colors hover:bg-accent/50 dark:bg-input/32 outline-none focus-visible:ring-ring/50 focus-visible:ring-[3px] cursor-pointer" aria-label="搜索">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="pr-6">搜索文章</span>
          <kbd class="pointer-events-none inline-flex h-5 min-w-5 select-none items-center justify-center gap-0.5 rounded bg-muted px-1 font-medium font-sans text-muted-foreground text-[0.625rem]" data-slot="kbd">Ctrl K</kbd>
        </button>

        <%# Search - Mobile: 图标按钮 %>
        <button type="button" id="search-toggle-mobile" class="md:hidden inline-flex items-center justify-center size-8 rounded-md text-sm font-medium transition-all hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 outline-none focus-visible:ring-ring/50 focus-visible:ring-[3px] cursor-pointer" aria-label="搜索">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </button>

        <%# Theme Toggle - Coss UI Menu 下拉（选项与图标参考 Cloud-PE-Website） %>
        <div class="relative" id="theme-menu">
          <button type="button" id="theme-trigger" aria-label="切换主题" aria-haspopup="menu" aria-expanded="false" class="[&_svg]:-mx-0.5 relative inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 whitespace-nowrap rounded-lg border font-medium text-base outline-none transition-shadow before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-lg)-1px)] focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 focus-visible:ring-offset-background sm:text-sm [&_svg:not([class*='opacity-'])]:opacity-80 [&_svg:not([class*='size-'])]:size-4.5 sm:[&_svg:not([class*='size-'])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0 size-9 sm:size-8 border-border bg-background bg-clip-padding shadow-xs not-disabled:not-active:not-data-pressed:before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-input/32 dark:not-in-data-[slot=group]:bg-clip-border dark:not-disabled:before:shadow-[0_-1px_--theme(--color-white/4%)] dark:not-disabled:not-active:not-data-pressed:before:shadow-[0_-1px_--theme(--color-white/8%)] [:hover,[data-pressed]]:bg-accent/50 dark:[:hover,[data-pressed]]:bg-input/64">
            <%# 浅色图标 %>
            <svg class="theme-icon-light hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <%# 深色图标 %>
            <svg class="theme-icon-dark hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
            <%# 跟随系统图标 (CircleHalf) %>
            <svg class="theme-icon-system hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
              <path d="M12 3l0 18"></path><path d="M12 9l4.65 -4.65"></path><path d="M12 14.3l7.37 -7.37"></path><path d="M12 19.6l8.85 -8.85"></path>
            </svg>
          </button>

          <%# 下拉菜单 - Coss UI MenuPopup %>
          <div id="theme-popup" class="theme-popup closed absolute right-0 top-full mt-2 z-50 min-w-[150px] rounded-lg border bg-popover bg-clip-padding shadow-lg outline-none before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-lg)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)]" role="menu" aria-label="主题选择">
            <div class="p-1">
              <button type="button" data-theme="light" role="menuitemradio" class="theme-option [&_svg]:-mx-0.5 flex min-h-8 w-full cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1 text-base outline-none hover:bg-accent hover:text-accent-foreground sm:min-h-7 sm:text-sm [&_svg:not([class*='opacity-'])]:opacity-80 [&_svg:not([class*='size-'])]:size-4.5 sm:[&_svg:not([class*='size-'])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
                浅色模式
                <svg class="theme-check ml-auto" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
              </button>
              <button type="button" data-theme="dark" role="menuitemradio" class="theme-option [&_svg]:-mx-0.5 flex min-h-8 w-full cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1 text-base outline-none hover:bg-accent hover:text-accent-foreground sm:min-h-7 sm:text-sm [&_svg:not([class*='opacity-'])]:opacity-80 [&_svg:not([class*='size-'])]:size-4.5 sm:[&_svg:not([class*='size-'])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
                深色模式
                <svg class="theme-check ml-auto" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
              </button>
              <button type="button" data-theme="system" role="menuitemradio" class="theme-option [&_svg]:-mx-0.5 flex min-h-8 w-full cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1 text-base outline-none hover:bg-accent hover:text-accent-foreground sm:min-h-7 sm:text-sm [&_svg:not([class*='opacity-'])]:opacity-80 [&_svg:not([class*='size-'])]:size-4.5 sm:[&_svg:not([class*='size-'])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path d="M12 3l0 18"></path><path d="M12 9l4.65 -4.65"></path><path d="M12 14.3l7.37 -7.37"></path><path d="M12 19.6l8.85 -8.85"></path></svg>
                跟随系统
                <svg class="theme-check ml-auto" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
              </button>
            </div>
          </div>
        </div>

        <%# Mobile Menu Toggle - Coss UI ghost icon button style %>
        <button type="button" class="inline-flex md:hidden items-center justify-center size-8 rounded-md text-sm font-medium transition-all hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 outline-none focus-visible:ring-ring/50 focus-visible:ring-[3px] cursor-pointer" id="mobile-menu-toggle" aria-label="打开菜单">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <%# Mobile Menu %>
  <div class="hidden md:hidden border-t coss-glass" id="mobile-menu">
    <nav class="flex flex-col space-y-1 p-4">
      <% if (theme.menu) { %>
        <% for (var key in theme.menu) { %>
          <% var menuPath = theme.menu[key]; %>
          <% var isLinksMenu = menuPath === '/links/' || menuPath === '/links'; %>
          <% var linksEnabled = !theme.links || theme.links.enable !== false; %>
          <% if (!isLinksMenu || linksEnabled) { %>
            <%
              var target = normalizePath(menuPath);
              var menuActive = target === '/' ? currentPath === '/' : (currentPath === target || currentPath.indexOf(target + '/') === 0);
            %>
            <a href="<%= url_for(menuPath) %>" class="flex items-center py-2.5 px-3 rounded-md text-base font-medium transition-colors <%= menuActive ? 'text-foreground bg-accent' : 'text-muted-foreground hover:text-foreground hover:bg-accent/60' %>">
              <%= key %>
            </a>
          <% } %>
        <% } %>
      <% } %>
    </nav>
  </div>
</header>
