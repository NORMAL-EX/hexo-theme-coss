<aside class="space-y-6">
  <%# Author Card %>
  <% if (!theme.sidebar || theme.sidebar.showAuthor !== false) { %>
  <div class="post-card relative flex flex-col rounded-2xl border bg-card bg-clip-padding text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)] overflow-hidden">
    <%# 顶部渐变条 %>
    <div class="h-16 bg-gradient-to-br from-info/25 via-primary/10 to-warning/20"></div>
    <div class="px-6 pb-6 -mt-10">
      <div class="flex flex-col items-center text-center">
        <% if (theme.author && theme.author.avatar) { %>
        <span class="inline-flex size-20 shrink-0 select-none items-center justify-center overflow-hidden rounded-full bg-background align-middle ring-4 ring-card shadow-md mb-3" data-slot="avatar">
          <img src="<%= url_for(theme.author.avatar) %>" alt="<%= config.author %>" class="size-full object-cover" data-slot="avatar-image">
        </span>
        <% } else { %>
        <span class="inline-flex size-20 shrink-0 select-none items-center justify-center overflow-hidden rounded-full bg-muted align-middle ring-4 ring-card shadow-md mb-3 text-2xl font-bold" data-slot="avatar"><%= config.author.charAt(0) %></span>
        <% } %>
        <h3 class="text-lg font-semibold"><%= config.author %></h3>
        <% if (theme.author && theme.author.description) { %>
        <p class="text-sm text-muted-foreground mt-1.5"><%= theme.author.description %></p>
        <% } else if (config.description) { %>
        <p class="text-sm text-muted-foreground mt-1.5"><%= config.description %></p>
        <% } %>

        <%# 数据统计 %>
        <div class="grid grid-cols-3 gap-2 w-full mt-5 pt-5 border-t">
          <a href="<%= url_for('/archives/') %>" class="flex flex-col items-center gap-0.5 rounded-lg py-1.5 transition-colors hover:bg-accent">
            <span class="text-lg font-bold tabular-nums"><%= site.posts.length %></span>
            <span class="text-xs text-muted-foreground">文章</span>
          </a>
          <a href="<%= url_for('/categories/') %>" class="flex flex-col items-center gap-0.5 rounded-lg py-1.5 transition-colors hover:bg-accent">
            <span class="text-lg font-bold tabular-nums"><%= site.categories.length %></span>
            <span class="text-xs text-muted-foreground">分类</span>
          </a>
          <a href="<%= url_for('/tags/') %>" class="flex flex-col items-center gap-0.5 rounded-lg py-1.5 transition-colors hover:bg-accent">
            <span class="text-lg font-bold tabular-nums"><%= site.tags.length %></span>
            <span class="text-xs text-muted-foreground">标签</span>
          </a>
        </div>

        <%# 社交链接 %>
        <% if (theme.social && theme.social.length > 0) { %>
        <div class="flex items-center justify-center gap-1 mt-4">
          <% for (var si = 0; si < theme.social.length; si++) { %>
            <% var s = theme.social[si]; %>
            <a href="<%= s.url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center size-8 rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground" title="<%= s.name %>" aria-label="<%= s.name %>">
              <% if (s.icon === 'github') { %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
              <% } else if (s.icon === 'twitter') { %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
              <% } else if (s.icon === 'email' || s.icon === 'mail') { %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              <% } else if (s.icon === 'rss') { %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
              <% } else { %>
              <span class="text-xs font-medium"><%= s.name %></span>
              <% } %>
            </a>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <%# Categories %>
  <% if ((!theme.sidebar || theme.sidebar.showCategories !== false) && site.categories.length > 0) { %>
  <div class="post-card relative flex flex-col rounded-2xl border bg-card bg-clip-padding text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)]">
    <div class="flex items-center gap-2 p-4 pb-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
      <h4 class="text-base font-semibold">分类</h4>
    </div>
    <div class="p-2 pt-0">
      <ul class="space-y-0.5">
        <% site.categories.sort('name').each(function(category) { %>
        <li>
          <a href="<%= url_for(category.path) %>" class="flex items-center justify-between gap-2 rounded-md px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
            <span class="truncate"><%= category.name %></span>
            <span class="relative inline-flex shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-sm border border-transparent font-medium outline-none transition-shadow h-5 min-w-5 px-[calc(--spacing(1)-1px)] text-xs bg-secondary text-secondary-foreground" data-slot="badge"><%= category.posts.length %></span>
          </a>
        </li>
        <% }); %>
      </ul>
    </div>
  </div>
  <% } %>

  <%# Tags %>
  <% if ((!theme.sidebar || theme.sidebar.showTags !== false) && site.tags.length > 0) { %>
  <div class="post-card relative flex flex-col rounded-2xl border bg-card bg-clip-padding text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)]">
    <div class="flex items-center gap-2 p-4 pb-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>
      <h4 class="text-base font-semibold">标签</h4>
    </div>
    <div class="p-4 pt-0">
      <div class="flex flex-wrap gap-1.5">
        <% site.tags.sort('name').each(function(tag) { %>
        <a href="<%= url_for(tag.path) %>" class="relative inline-flex shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-sm border border-transparent font-medium outline-none transition-shadow focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 focus-visible:ring-offset-background [&_svg:not([class*='opacity-'])]:opacity-80 [&_svg:not([class*='size-'])]:size-3.5 sm:[&_svg:not([class*='size-'])]:size-3 [&_svg]:pointer-events-none [&_svg]:shrink-0 [button,a&]:cursor-pointer h-5.5 min-w-5.5 px-1.5 text-sm sm:h-4.5 sm:text-xs border-border bg-transparent dark:bg-input/32 [button,a&]:hover:bg-accent/50 dark:[button,a&]:hover:bg-input/48" data-slot="badge">
          <%= tag.name %>
          <span class="text-muted-foreground">·<%= tag.posts.length %></span>
        </a>
        <% }); %>
      </div>
    </div>
  </div>
  <% } %>

  <%# Recent Posts %>
  <% if (!theme.sidebar || theme.sidebar.showRecent !== false) { %>
  <% var recentCount = (theme.sidebar && theme.sidebar.recentPostsCount) || 5; %>
  <div class="post-card relative flex flex-col rounded-2xl border bg-card bg-clip-padding text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)]">
    <div class="flex items-center gap-2 p-4 pb-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <h4 class="text-base font-semibold">最新文章</h4>
    </div>
    <div class="p-2 pt-0">
      <ul class="space-y-0.5">
        <% site.posts.sort('-date').limit(recentCount).each(function(post) { %>
        <li>
          <a href="<%= url_for(post.path) %>" class="flex flex-col gap-0.5 rounded-md px-2 py-1.5 transition-colors hover:bg-accent group">
            <span class="text-sm font-medium line-clamp-1 group-hover:text-primary transition-colors"><%= post.title %></span>
            <span class="text-xs text-muted-foreground tabular-nums"><%= date(post.date, 'YYYY-MM-DD') %></span>
          </a>
        </li>
        <% }); %>
      </ul>
    </div>
  </div>
  <% } %>
</aside>
