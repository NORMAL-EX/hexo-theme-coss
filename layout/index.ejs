<%# Hero Section - 第一屏 %>
<section id="hero" class="min-h-svh flex flex-col justify-center relative -mt-14 overflow-hidden">
  <%# 渐变光晕 + 网格背景 %>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-orb" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-end gap-8 pl-4 sm:pl-8 lg:pl-12">
      <%# 左侧：头像、标题、副标题、社交链接、统计 %>
      <div class="flex-1 max-w-3xl">
        <%# 作者头像 %>
        <% if (theme.author && theme.author.avatar) { %>
        <span class="coss-rise coss-rise-1 inline-flex size-16 shrink-0 select-none items-center justify-center overflow-hidden rounded-2xl bg-background align-middle ring-1 ring-border shadow-md mb-6" data-slot="avatar">
          <img src="<%= url_for(theme.author.avatar) %>" alt="<%= config.author %>" class="size-full object-cover" data-slot="avatar-image">
        </span>
        <% } %>

        <%# 主标题 - 支持 gradient-highlight %>
        <h1 class="coss-rise coss-rise-2 text-5xl sm:text-6xl lg:text-7xl font-bold mb-4 text-left leading-tight tracking-tight"><%-
          (theme.index && theme.index.title ? theme.index.title : '最新文章')
            .replace(/\{\{highlight\}\}(.*?)\{\{\/highlight\}\}/g, '<span class="gradient-highlight">$1</span>')
        %></h1>

        <%# 副标题 %>
        <p class="coss-rise coss-rise-3 text-xl sm:text-2xl text-muted-foreground mb-8 text-left"><%-
          (theme.index && theme.index.subtitle ? theme.index.subtitle : '分享技术、生活与思考')
            .replace(/\{\{highlight\}\}(.*?)\{\{\/highlight\}\}/g, '<span class="gradient-highlight">$1</span>')
        %></p>

        <div class="coss-rise coss-rise-4 flex flex-wrap items-center gap-x-6 gap-y-4">
          <%# 社交链接 %>
          <% if (theme.social && theme.social.length > 0) { %>
          <div class="flex items-center gap-1">
            <% for (var i = 0; i < theme.social.length; i++) { %>
              <% var item = theme.social[i]; %>
              <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center size-9 rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground outline-none focus-visible:ring-ring/50 focus-visible:ring-[3px]" title="<%= item.name %>" aria-label="<%= item.name %>">
                <% if (item.icon === 'github') { %>
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                <% } else if (item.icon === 'twitter') { %>
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
                <% } else if (item.icon === 'email' || item.icon === 'mail') { %>
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                <% } else if (item.icon === 'rss') { %>
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
                <% } else { %>
                <span class="text-sm font-medium px-1"><%= item.name %></span>
                <% } %>
              </a>
            <% } %>
          </div>
          <% } %>

          <%# 数据徽标 %>
          <div class="flex items-center gap-4 text-sm text-muted-foreground">
            <span class="inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
              <span class="font-semibold text-foreground tabular-nums"><%= site.posts.length %></span> 篇文章
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>
              <span class="font-semibold text-foreground tabular-nums"><%= site.tags.length %></span> 个标签
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# 向下滚动按钮 - 底部居中 Coss UI outline icon button style %>
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
    <button id="scroll-to-posts" class="inline-flex items-center justify-center size-10 rounded-full border bg-background bg-clip-padding shadow-lg animate-bounce transition-all hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 outline-none focus-visible:ring-ring/50 focus-visible:ring-[3px] cursor-pointer text-muted-foreground" aria-label="向下滚动">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </button>
  </div>
</section>

<%# 文章列表区域 %>
<section id="posts" class="py-16 relative">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <%# Main Content %>
      <div class="flex-1 min-w-0">
        <%# 区块标题 %>
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center justify-center size-9 rounded-lg border bg-card text-primary shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 12h-5"></path><path d="M15 8h-5"></path><path d="M19 17V5a2 2 0 0 0-2-2H4"></path><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"></path></svg>
          </span>
          <h2 class="text-2xl font-bold tracking-tight">最新文章</h2>
        </div>

        <%# Post List %>
        <% if (page.posts.length > 0) { %>
        <div class="grid grid-cols-1 gap-6">
          <% page.posts.each(function(post) { %>
          <%
            var plainContent = (post.content || '').replace(/<[^>]+>/g, '');
            var wordCount = plainContent.replace(/\s+/g, '').length;
            var readTime = Math.max(1, Math.ceil(wordCount / 350));
          %>
          <article class="post-card group relative flex flex-col rounded-2xl border bg-card bg-clip-padding text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)] overflow-hidden">
            <%# Cover Image %>
            <% if (post.cover) { %>
            <a href="<%= url_for(post.path) %>" class="block cover-zoom">
              <div class="aspect-video overflow-hidden">
                <img src="<%= post.cover %>" alt="<%= post.title %>" loading="lazy" class="w-full h-full object-cover">
              </div>
            </a>
            <% } %>

            <div class="p-6">
              <%# Sticky Badge - Coss UI warning badge %>
              <% if (post.sticky) { %>
              <span class="relative inline-flex shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-sm border border-transparent font-medium outline-none transition-shadow [&_svg:not([class*='size-'])]:size-3 [&_svg]:pointer-events-none [&_svg]:shrink-0 h-5.5 px-1.5 text-xs sm:h-4.5 sm:text-[0.625rem] bg-warning/8 text-warning-foreground dark:bg-warning/16 mb-3" data-slot="badge">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17v5"></path><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"></path></svg>
                置顶
              </span>
              <% } %>

              <%# Title %>
              <h2 class="text-xl font-semibold mb-3 text-left">
                <a href="<%= url_for(post.path) %>" class="transition-colors group-hover:text-primary">
                  <%= post.title %>
                </a>
              </h2>

              <%# Meta Info %>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground mb-3">
                <span class="post-stat">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
                  <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
                </span>

                <% if (post.categories && post.categories.length > 0) { %>
                <span class="post-stat">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
                  <% post.categories.each(function(cat, idx) { %><a href="<%= url_for(cat.path) %>" class="hover:text-foreground transition-colors"><%= cat.name %></a><% if (idx < post.categories.length - 1) { %>, <% } %><% }); %>
                </span>
                <% } %>

                <% if (wordCount > 0) { %>
                <span class="post-stat">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  约 <%= readTime %> 分钟
                </span>
                <% } %>
              </div>

              <%# Excerpt %>
              <% var excerptText = post.excerpt ? strip_html(post.excerpt) : (post.content ? strip_html(truncate(post.content, {length: 200})) : ''); %>
              <% if (excerptText && excerptText.trim()) { %>
              <p class="text-muted-foreground text-sm leading-relaxed line-clamp-2 mb-4 text-left"><%- excerptText %></p>
              <% } %>

              <%# Footer: Tags + 阅读更多 %>
              <div class="flex items-center justify-between gap-3">
                <% if (post.tags && post.tags.length > 0) { %>
                <div class="flex flex-wrap gap-1.5 min-w-0">
                  <% post.tags.each(function(tag) { %>
                  <a href="<%= url_for(tag.path) %>" class="relative inline-flex shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-sm border border-transparent font-medium outline-none transition-shadow focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 focus-visible:ring-offset-background [&_svg:not([class*='size-'])]:size-3 [&_svg]:pointer-events-none [&_svg]:shrink-0 [button,a&]:cursor-pointer h-5.5 min-w-5.5 px-1.5 text-xs sm:h-4.5 sm:text-[0.625rem] bg-secondary text-secondary-foreground [button,a&]:hover:bg-secondary/90" data-slot="badge">
                    <%= tag.name %>
                  </a>
                  <% }); %>
                </div>
                <% } else { %>
                <span></span>
                <% } %>
                <a href="<%= url_for(post.path) %>" class="post-stat shrink-0 text-sm font-medium text-primary transition-opacity hover:opacity-80">
                  阅读
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </a>
              </div>
            </div>
          </article>
          <% }); %>
        </div>

        <%# Pagination %>
        <%- partial('_partial/pagination') %>

        <% } else { %>
        <%# Empty State - Coss UI Empty %>
        <div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-6 text-balance rounded-xl border border-dashed p-12 text-center" data-slot="empty">
          <div class="relative mb-2" data-slot="empty-media">
            <div class="relative flex size-12 shrink-0 items-center justify-center rounded-md border bg-card text-muted-foreground shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            </div>
          </div>
          <div class="flex flex-col items-center gap-1">
            <div class="font-semibold text-xl leading-none">暂无文章</div>
            <p class="text-muted-foreground text-sm">开始撰写你的第一篇文章吧</p>
          </div>
        </div>
        <% } %>
      </div>

      <%# Sidebar - only show if there's content %>
      <%
        var showAuthor = !theme.sidebar || theme.sidebar.showAuthor !== false;
        var showCategories = (!theme.sidebar || theme.sidebar.showCategories !== false) && site.categories.length > 0;
        var showTags = (!theme.sidebar || theme.sidebar.showTags !== false) && site.tags.length > 0;
        var showRecent = !theme.sidebar || theme.sidebar.showRecent !== false;
        var hasSidebarContent = showAuthor || showCategories || showTags || showRecent;
      %>
      <% if (hasSidebarContent) { %>
      <div class="w-full lg:w-80 shrink-0">
        <div class="lg:sticky lg:top-20">
          <%- partial('_partial/sidebar') %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</section>
