<div class="py-8">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <%# Main Content %>
      <div class="flex-1 min-w-0">
        <%# Page Title %>
        <div class="flex items-center gap-3 mb-2">
          <span class="inline-flex items-center justify-center size-10 rounded-xl border bg-card text-primary shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
          </span>
          <h1 class="text-3xl font-bold tracking-tight">
            <% if (page.category) { %><%= page.category %><% } else { %>分类<% } %>
          </h1>
        </div>
        <p class="text-muted-foreground mb-8 text-left">
          <% if (page.category) { %>共 <span class="font-semibold text-foreground tabular-nums"><%= page.posts.length %></span> 篇文章<% } else { %>共 <span class="font-semibold text-foreground tabular-nums"><%= site.categories.length %></span> 个分类<% } %>
        </p>

        <% if (page.category) { %>
        <%# Posts in Category %>
        <div class="grid grid-cols-1 gap-6">
          <% page.posts.each(function(post) { %>
          <article class="post-card group relative flex flex-col rounded-2xl border bg-card bg-clip-padding text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)] overflow-hidden">
            <% if (post.cover) { %>
            <a href="<%= url_for(post.path) %>" class="block cover-zoom">
              <div class="aspect-video overflow-hidden">
                <img src="<%= post.cover %>" alt="<%= post.title %>" loading="lazy" class="w-full h-full object-cover">
              </div>
            </a>
            <% } %>
            <div class="p-6">
              <h2 class="text-xl font-semibold mb-3 text-left">
                <a href="<%= url_for(post.path) %>" class="transition-colors group-hover:text-primary"><%= post.title %></a>
              </h2>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground mb-3">
                <span class="post-stat">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
                  <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
                </span>
              </div>
              <% if (post.excerpt) { %>
              <p class="text-muted-foreground text-sm leading-relaxed line-clamp-2 text-left"><%- strip_html(post.excerpt) %></p>
              <% } %>
            </div>
          </article>
          <% }); %>
        </div>

        <%- partial('_partial/pagination') %>

        <% } else if (site.categories.length > 0) { %>
        <%# All Categories %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% site.categories.sort('name').each(function(category) { %>
          <a href="<%= url_for(category.path) %>" class="post-card group relative flex items-center justify-between gap-4 rounded-2xl border bg-card bg-clip-padding p-5 text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)]">
            <div class="flex items-center gap-3 min-w-0">
              <span class="inline-flex items-center justify-center size-10 rounded-lg border bg-background text-muted-foreground shadow-xs transition-colors group-hover:text-primary shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
              </span>
              <span class="font-medium truncate group-hover:text-primary transition-colors"><%= category.name %></span>
            </div>
            <span class="relative inline-flex shrink-0 items-center justify-center rounded-sm border border-transparent font-medium h-5.5 min-w-5.5 px-1.5 text-xs bg-secondary text-secondary-foreground" data-slot="badge"><%= category.posts.length %> 篇</span>
          </a>
          <% }); %>
        </div>
        <% } else { %>
        <%# Empty State %>
        <div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-4 rounded-xl border border-dashed p-12 text-center" data-slot="empty">
          <div class="relative flex size-12 shrink-0 items-center justify-center rounded-md border bg-card text-muted-foreground shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
          </div>
          <div class="font-semibold text-xl leading-none">暂无分类</div>
        </div>
        <% } %>
      </div>

      <%# Sidebar %>
      <%
        var showAuthor = !theme.sidebar || theme.sidebar.showAuthor !== false;
        var showCategories = (!theme.sidebar || theme.sidebar.showCategories !== false) && site.categories.length > 0;
        var showTags = (!theme.sidebar || theme.sidebar.showTags !== false) && site.tags.length > 0;
        var showRecent = !theme.sidebar || theme.sidebar.showRecent !== false;
        var hasSidebarContent = showAuthor || showCategories || showTags || showRecent;
      %>
      <% if (hasSidebarContent) { %>
      <div class="w-full lg:w-80 shrink-0">
        <div class="lg:sticky lg:top-20">
          <%- partial('_partial/sidebar') %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>
