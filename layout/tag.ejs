<div class="py-8">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8">
      <%# Main Content %>
      <div class="flex-1 min-w-0">
        <%# Page Title %>
        <div class="flex items-center gap-3 mb-2">
          <span class="inline-flex items-center justify-center size-10 rounded-xl border bg-card text-primary shadow-xs">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>
          </span>
          <h1 class="text-3xl font-bold tracking-tight">
            <% if (page.tag) { %># <%= page.tag %><% } else { %>标签<% } %>
          </h1>
        </div>
        <p class="text-muted-foreground mb-8 text-left">
          <% if (page.tag) { %>共 <span class="font-semibold text-foreground tabular-nums"><%= page.posts.length %></span> 篇文章<% } else { %>共 <span class="font-semibold text-foreground tabular-nums"><%= site.tags.length %></span> 个标签<% } %>
        </p>

        <% if (page.tag) { %>
        <%# Posts with Tag %>
        <div class="grid grid-cols-1 gap-6">
          <% page.posts.each(function(post) { %>
          <article class="post-card group relative flex flex-col rounded-2xl border bg-card bg-clip-padding text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)] overflow-hidden">
            <% if (post.cover) { %>
            <a href="<%= url_for(post.path) %>" class="block cover-zoom">
              <div class="aspect-video overflow-hidden">
                <img src="<%= post.cover %>" alt="<%= post.title %>" loading="lazy" class="w-full h-full object-cover">
              </div>
            </a>
            <% } %>
            <div class="p-6">
              <h2 class="text-xl font-semibold mb-3 text-left">
                <a href="<%= url_for(post.path) %>" class="transition-colors group-hover:text-primary"><%= post.title %></a>
              </h2>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground mb-3">
                <span class="post-stat">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
                  <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
                </span>
                <% if (post.categories && post.categories.length > 0) { %>
                <span class="post-stat">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
                  <% post.categories.each(function(cat, idx) { %><a href="<%= url_for(cat.path) %>" class="hover:text-foreground transition-colors"><%= cat.name %></a><% if (idx < post.categories.length - 1) { %>, <% } %><% }); %>
                </span>
                <% } %>
              </div>
              <% if (post.excerpt) { %>
              <p class="text-muted-foreground text-sm leading-relaxed line-clamp-2 text-left"><%- strip_html(post.excerpt) %></p>
              <% } %>
            </div>
          </article>
          <% }); %>
        </div>

        <%- partial('_partial/pagination') %>

        <% } else if (site.tags.length > 0) { %>
        <%# All Tags (Tag Cloud) %>
        <div class="relative flex flex-col rounded-2xl border bg-card bg-clip-padding text-card-foreground shadow-xs before:pointer-events-none before:absolute before:inset-0 before:rounded-[calc(var(--radius-2xl)-1px)] before:shadow-[0_1px_--theme(--color-black/4%)] dark:bg-clip-border dark:before:shadow-[0_-1px_--theme(--color-white/8%)] p-6 lg:p-8">
          <div class="flex flex-wrap gap-3 items-center">
            <%
            var tags = site.tags.sort('name');
            var maxCount = 1;
            tags.each(function(tag) { if (tag.posts.length > maxCount) { maxCount = tag.posts.length; } });
            %>
            <% tags.each(function(tag) { %>
            <%
            var ratio = tag.posts.length / maxCount;
            var size;
            if (ratio > 0.8) size = 'text-2xl';
            else if (ratio > 0.6) size = 'text-xl';
            else if (ratio > 0.4) size = 'text-lg';
            else if (ratio > 0.2) size = 'text-base';
            else size = 'text-sm';
            %>
            <a href="<%= url_for(tag.path) %>" class="tag-cloud-item inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-border bg-background dark:bg-input/32 <%= size %>">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>
              <span class="font-medium"><%= tag.name %></span>
              <span class="text-xs text-muted-foreground tabular-nums"><%= tag.posts.length %></span>
            </a>
            <% }); %>
          </div>
        </div>
        <% } else { %>
        <%# Empty State %>
        <div class="flex min-w-0 flex-1 flex-col items-center justify-center gap-4 rounded-xl border border-dashed p-12 text-center" data-slot="empty">
          <div class="relative flex size-12 shrink-0 items-center justify-center rounded-md border bg-card text-muted-foreground shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>
          </div>
          <div class="font-semibold text-xl leading-none">暂无标签</div>
        </div>
        <% } %>
      </div>

      <%# Sidebar %>
      <%
        var showAuthor = !theme.sidebar || theme.sidebar.showAuthor !== false;
        var showCategories = (!theme.sidebar || theme.sidebar.showCategories !== false) && site.categories.length > 0;
        var showTags = (!theme.sidebar || theme.sidebar.showTags !== false) && site.tags.length > 0;
        var showRecent = !theme.sidebar || theme.sidebar.showRecent !== false;
        var hasSidebarContent = showAuthor || showCategories || showTags || showRecent;
      %>
      <% if (hasSidebarContent) { %>
      <div class="w-full lg:w-80 shrink-0">
        <div class="lg:sticky lg:top-20">
          <%- partial('_partial/sidebar') %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>
